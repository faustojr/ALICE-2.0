# ============================================================================
# ALICE 2.0 — variáveis de ambiente
#
# Local:  copie para .env.local e preencha.
# Vercel: cadastre cada uma em Settings → Environment Variables.
#
# NUNCA versione .env.local nem o JSON da service account.
# ============================================================================

# --- Frontend (expostas ao browser via Vite; use apenas chaves públicas) ----
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=seu-projeto.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=seu-projeto.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
# Só se o projeto usa um database Firestore nomeado (não "(default)")
VITE_FIRESTORE_DATABASE_ID=

# --- Backend (servidor apenas; nunca prefixe com VITE_) ---------------------

# Chave da API Gemini (Google AI Studio)
GEMINI_API_KEY=

# Modelo usado na geração. Trocar de modelo é mudar esta variável,
# sem deploy de código. Confirme o id disponível na sua conta do AI Studio.
GEMINI_MODEL=gemini-2.5-flash

# Service account do Firebase Admin (JSON em uma linha, ou o mesmo em base64).
# Firebase Console → Configurações do projeto → Contas de serviço → Gerar chave.
FIREBASE_SERVICE_ACCOUNT=

# Id do database Firestore no servidor (igual ao VITE_FIRESTORE_DATABASE_ID)
FIRESTORE_DATABASE_ID=

# E-mails da equipe ALICE com acesso ao console administrativo, separados
# por vírgula. Sem isto, o console fica indisponível.
SUPER_ADMIN_EMAILS=seu-email@gmail.com

# Origens autorizadas a chamar a API, separadas por vírgula.
ALLOWED_ORIGINS=https://appalice.cloud,https://aprendacomalice.com,http://localhost:3000

# --- Carga do acervo de imagens (scripts/seedReelImages.mjs) ---------------
# Chave gratuita da API do Pexels, só para rodar a carga localmente.
PEXELS_API_KEY=
# Bucket do Firebase Storage onde as imagens ficam.
FIREBASE_STORAGE_BUCKET=seu-projeto.firebasestorage.app
